{
  "name": "@your-org/feature-flags-sdk",
  "version": "1.0.0",
  "description": "Feature flags SDK using OpenFeature with LaunchDarkly provider",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "jest",
    "example:basic": "npm run build && node examples/basic-usage.js",
    "example:express": "npm run build && node examples/express-app.js",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:@openfeature/server-sdk --external:@launchdarkly/openfeature-node-server && tsc",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "feature-flags",
    "openfeature",
    "launchdarkly",
    "feature-toggles"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@launchdarkly/openfeature-node-server": "^0.3.0",
    "@openfeature/server-sdk": "^1.13.0"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.13.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "esbuild": "^0.24.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
